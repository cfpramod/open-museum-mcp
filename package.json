{
  "name": "open-museum-mcp",
  "version": "0.5.0",
  "description": "MCP server for license-verified search across open-access museum collections (The Met, Cleveland, AIC, Wikimedia Commons, Europeana).",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "open-museum-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfpramod/open-museum-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cfpramod/open-museum-mcp/issues"
  },
  "homepage": "https://github.com/cfpramod/open-museum-mcp#readme",
  "scripts": {
    "build": "tsc",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx src/server.ts",
    "prepare": "npm run build",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-sqlite vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "museum",
    "open-access",
    "art",
    "art-history",
    "metropolitan-museum",
    "cleveland-museum",
    "art-institute-chicago",
    "wikimedia-commons",
    "europeana"
  ],
  "author": "Pramod Prasanth",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
